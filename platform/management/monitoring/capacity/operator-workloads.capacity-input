# Capacity-only projections of workloads generated by Prometheus Operator
# v0.93.0. The non-manifest suffix prevents this reducer input from entering
# Kubernetes desired-state discovery. It must never be submitted to the API.
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: capacity-model-prometheus
  namespace: monitoring
  annotations:
    capacity.platform.verda.io/projection-only: "true"
    capacity.platform.verda.io/source: prometheus-operator-v0.93.0
spec:
  replicas: 1
  updateStrategy:
    type: RollingUpdate
  template:
    spec:
      initContainers:
        - name: init-config-reloader
          image: quay.io/prometheus-operator/prometheus-config-reloader:v0.93.0
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 128Mi
      containers:
        - name: prometheus
          image: quay.io/prometheus/prometheus:v3.13.2-distroless
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              cpu: "1"
              memory: 1536Mi
        - name: config-reloader
          image: quay.io/prometheus-operator/prometheus-config-reloader:v0.93.0
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 128Mi
  volumeClaimTemplates:
    - metadata:
        name: prometheus-data
      spec:
        accessModes:
          - ReadWriteOnce
        storageClassName: longhorn-critical
        resources:
          requests:
            storage: 10Gi
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: capacity-model-alertmanager
  namespace: monitoring
  annotations:
    capacity.platform.verda.io/projection-only: "true"
    capacity.platform.verda.io/source: prometheus-operator-v0.93.0
spec:
  replicas: 1
  updateStrategy:
    type: RollingUpdate
  template:
    spec:
      initContainers:
        - name: init-config-reloader
          image: quay.io/prometheus-operator/prometheus-config-reloader:v0.93.0
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 128Mi
      containers:
        - name: alertmanager
          image: quay.io/prometheus/alertmanager:v0.33.1
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 200m
              memory: 256Mi
        - name: config-reloader
          image: quay.io/prometheus-operator/prometheus-config-reloader:v0.93.0
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              cpu: 100m
              memory: 128Mi
  volumeClaimTemplates:
    - metadata:
        name: alertmanager-data
      spec:
        accessModes:
          - ReadWriteOnce
        storageClassName: longhorn-critical
        resources:
          requests:
            storage: 2Gi

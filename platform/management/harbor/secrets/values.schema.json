{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "gates", "ciphertexts"],
  "allOf": [
    {
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {
        "properties": {
          "gates": {
            "properties": {"ciphertextsLocked": {"const": true}}
          },
          "ciphertexts": {
            "patternProperties": {
              ".*": {"pattern": "^Ag[A-Za-z0-9+/=]{78,}$"}
            }
          }
        }
      }
    }
  ],
  "properties": {
    "enabled": {"type": "boolean"},
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ciphertextsLocked"],
      "properties": {"ciphertextsLocked": {"type": "boolean"}}
    },
    "ciphertexts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adminPassword", "coreSecretKey", "coreSecret", "coreXsrfKey",
        "tokenPrivateKey", "tokenCertificate", "jobserviceSecret",
        "registryHttpSecret", "registryPassword", "registryHtpasswd",
        "databasePassword", "databasePostgresPassword"
      ],
      "properties": {
        "adminPassword": {"type": "string"},
        "coreSecretKey": {"type": "string"},
        "coreSecret": {"type": "string"},
        "coreXsrfKey": {"type": "string"},
        "tokenPrivateKey": {"type": "string"},
        "tokenCertificate": {"type": "string"},
        "jobserviceSecret": {"type": "string"},
        "registryHttpSecret": {"type": "string"},
        "registryPassword": {"type": "string"},
        "registryHtpasswd": {"type": "string"},
        "databasePassword": {"type": "string"},
        "databasePostgresPassword": {"type": "string"}
      }
    }
  }
}

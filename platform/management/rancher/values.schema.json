{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["gates", "certificate", "rancher"],
  "properties": {
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stagingCertificateVerified", "imageDigestsLocked"],
      "properties": {
        "stagingCertificateVerified": {"type": "boolean"},
        "imageDigestsLocked": {"type": "boolean"}
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acmeEmail", "ingressClassName", "stagingSecretName", "productionSecretName"],
      "properties": {
        "acmeEmail": {"type": "string", "format": "email", "minLength": 3},
        "ingressClassName": {"type": "string", "const": "traefik"},
        "stagingSecretName": {"type": "string", "const": "rancher-staging-tls"},
        "productionSecretName": {"type": "string", "const": "tls-rancher-ingress"}
      }
    },
    "rancher": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled", "fullnameOverride", "hostname", "replicas", "priorityClassName",
        "antiAffinity", "topologyKey", "agentTLSMode", "addLocal", "bootstrapPassword",
        "privateCA", "tls", "useBundledSystemChart", "networkExposure", "ingress",
        "service", "image", "resources", "auditLog", "postDelete", "preUpgrade",
        "certmanager", "customLogos", "extraEnv"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "fullnameOverride": {"type": "string", "const": "rancher"},
        "hostname": {
          "type": "string",
          "pattern": "^rancher\\.(?:(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})-){3}(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})\\.nip\\.io$"
        },
        "replicas": {"type": "integer", "const": 3},
        "priorityClassName": {"type": "string", "const": "platform-critical"},
        "antiAffinity": {"type": "string", "const": "required"},
        "topologyKey": {"type": "string", "const": "kubernetes.io/hostname"},
        "agentTLSMode": {"type": "string", "const": "strict"},
        "addLocal": {"type": "string", "const": "true"},
        "bootstrapPassword": {"type": "string", "maxLength": 0},
        "privateCA": {"type": "boolean", "const": false},
        "tls": {"type": "string", "const": "ingress"},
        "useBundledSystemChart": {"type": "boolean", "const": false},
        "networkExposure": {
          "type": "object", "additionalProperties": true, "required": ["type"],
          "properties": {"type": {"type": "string", "const": "ingress"}}
        },
        "ingress": {
          "type": "object", "additionalProperties": true,
          "required": ["enabled", "includeDefaultExtraAnnotations", "ingressClassName", "pathType", "path", "servicePort", "extraAnnotations", "tls"],
          "properties": {
            "enabled": {"type": "boolean", "const": true},
            "includeDefaultExtraAnnotations": {"type": "boolean", "const": false},
            "ingressClassName": {"type": "string", "const": "traefik"},
            "pathType": {"type": "string", "const": "Prefix"},
            "path": {"type": "string", "const": "/"},
            "servicePort": {"type": "integer", "const": 80},
            "extraAnnotations": {
              "type": "object", "additionalProperties": true,
              "required": ["traefik.ingress.kubernetes.io/router.entrypoints", "verda.platform/authentication-boundary"],
              "properties": {
                "traefik.ingress.kubernetes.io/router.entrypoints": {"type": "string", "const": "websecure"},
                "verda.platform/authentication-boundary": {"type": "string", "const": "rancher-local-rbac"}
              }
            },
            "tls": {
              "type": "object", "additionalProperties": true, "required": ["source", "secretName"],
              "properties": {
                "source": {"type": "string", "const": "secret"},
                "secretName": {"type": "string", "const": "tls-rancher-ingress"}
              }
            }
          }
        },
        "service": {
          "type": "object", "additionalProperties": true, "required": ["type", "disableHTTP"],
          "properties": {
            "type": {"type": "string", "const": "ClusterIP"},
            "disableHTTP": {"type": "boolean", "const": false}
          }
        },
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "auditLog": {
          "type": "object", "additionalProperties": true,
          "required": ["enabled", "level", "destination", "maxAge", "maxBackup", "maxSize", "resources", "image"],
          "properties": {
            "enabled": {"type": "boolean", "const": true},
            "level": {"type": "integer", "const": 0},
            "destination": {"type": "string", "const": "sidecar"},
            "maxAge": {"type": "integer", "minimum": 1, "maximum": 7},
            "maxBackup": {"type": "integer", "minimum": 1, "maximum": 7},
            "maxSize": {"type": "integer", "minimum": 10, "maximum": 100},
            "resources": {"$ref": "#/definitions/resources"},
            "image": {"$ref": "#/definitions/image"}
          }
        },
        "postDelete": {
          "type": "object", "additionalProperties": true, "required": ["enabled", "image"],
          "properties": {
            "enabled": {"type": "boolean", "const": false},
            "image": {"$ref": "#/definitions/imageWithoutPullPolicy"}
          }
        },
        "preUpgrade": {
          "type": "object", "additionalProperties": true, "required": ["image"],
          "properties": {"image": {"$ref": "#/definitions/imageWithoutPullPolicy"}}
        },
        "certmanager": {
          "type": "object", "additionalProperties": true, "required": ["version"],
          "properties": {"version": {"type": "string", "const": "v1.21.1"}}
        },
        "customLogos": {
          "type": "object", "additionalProperties": true, "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean", "const": false}}
        },
        "extraEnv": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "value"],
            "properties": {
              "name": {"type": "string", "const": "CATTLE_PROMETHEUS_METRICS"},
              "value": {"type": "string", "const": "true"}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object", "additionalProperties": true, "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 3},
        "tag": {"type": "string", "minLength": 3},
        "pullPolicy": {"type": "string", "const": "IfNotPresent"}
      }
    },
    "imageWithoutPullPolicy": {
      "type": "object", "additionalProperties": true, "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "const": "rancher/shell"},
        "tag": {"type": "string", "minLength": 3}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}
        },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
          "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}
        }
      }
    }
  }
}

#!/usr/bin/env bash
set -Eeuo pipefail
# Node-local timed rollback; no secret material leaves the host.

drop_in=/etc/ssh/sshd_config.d/90-verda-platform.conf
backup=/run/phase3-ssh-rollback.conf
present=/run/phase3-ssh-rollback.present

case "${1:-}" in
  prepare)
    rm -f -- "${backup}" "${present}"
    if [[ -f "${drop_in}" ]]; then
      install -m 0600 -- "${drop_in}" "${backup}"
      touch "${present}"
    fi
    ;;
  restore)
    if [[ -f "${present}" ]]; then
      install -m 0600 -- "${backup}" "${drop_in}"
    else
      rm -f -- "${drop_in}"
    fi
    /usr/sbin/sshd -t -f /etc/ssh/sshd_config
    systemctl reload ssh
    ;;
  *)
    echo 'usage: phase3-ssh-rollback prepare|restore' >&2
    exit 64
    ;;
esac

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostname", "tlsSecretName", "networkPolicyOwner", "gates"],
  "properties": {
    "hostname": {
      "type": "string",
      "pattern": "^argocd\\.[0-9]{1,3}(-[0-9]{1,3}){3}\\.sslip\\.io$"
    },
    "tlsSecretName": {
      "type": "string",
      "const": "argocd-ingress-tls"
    },
    "networkPolicyOwner": {
      "type": "string",
      "const": "bootstrap-helm"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionCertificateVerified",
        "argocdAuthenticationVerified",
        "argocdInternalHttpVerified"
      ],
      "properties": {
        "productionCertificateVerified": {
          "type": "boolean"
        },
        "argocdAuthenticationVerified": {
          "type": "boolean"
        },
        "argocdInternalHttpVerified": {
          "type": "boolean"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verda.example/schemas/phase6-transaction-journal-v2.schema.json",
  "title": "Phase 6 crash-safe transaction journal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "operation_id", "operation_nonce", "authorization_commit",
    "authorization_sha256", "authorization_history_sha256", "verifier_receipt_sha256", "broker_sha256", "policy_sha256",
    "rollback_policy_sha256", "integrated_commit", "node", "direction", "plan_sha256",
    "plan_semantic_sha256", "state_lineage_sha256", "state_serial_before", "state_serial_after",
    "generation", "cas_nonce", "lease_id", "state", "recovery_milestone",
    "rollback_milestone", "prepare_receipt_sha256", "apply_receipt_sha256",
    "state_backup_sha256", "recovery_receipt_sha256", "postflight_sha256",
    "rollback_receipt_sha256", "latest_gate_sha256", "failure_class", "rollback_required",
    "start_by", "complete_by", "resource_expiry_utc", "minimum_recovery_margin_seconds",
    "started_at", "updated_at", "history", "raw_values_recorded"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "phase": {"const": 6},
    "operation_id": {"$ref": "#/$defs/digest"},
    "operation_nonce": {"$ref": "#/$defs/digest"},
    "authorization_commit": {"$ref": "#/$defs/commit"},
    "authorization_sha256": {"$ref": "#/$defs/digest"},
    "authorization_history_sha256": {"$ref": "#/$defs/digest"},
    "verifier_receipt_sha256": {"$ref": "#/$defs/digest"},
    "broker_sha256": {"$ref": "#/$defs/digest"},
    "policy_sha256": {"$ref": "#/$defs/digest"},
    "rollback_policy_sha256": {"$ref": "#/$defs/digest"},
    "integrated_commit": {"$ref": "#/$defs/commit"},
    "node": {"enum": ["01", "02", "03"]},
    "direction": {"enum": ["resize", "rollback"]},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "plan_semantic_sha256": {"$ref": "#/$defs/digest"},
    "state_lineage_sha256": {"$ref": "#/$defs/digest"},
    "state_serial_before": {"type": "integer", "minimum": 0},
    "state_serial_after": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "generation": {"type": "integer", "minimum": 1},
    "cas_nonce": {"$ref": "#/$defs/digest"},
    "lease_id": {"$ref": "#/$defs/digest"},
    "state": {"enum": ["AUTHORIZED", "PREPARING", "PREPARED", "APPLYING", "APPLIED", "RECOVERING", "RECOVERED", "POSTFLIGHT", "COMPLETED", "ROLLBACK_REQUIRED", "ROLLING_BACK", "ROLLED_BACK", "FAILED_SAFE"]},
    "recovery_milestone": {"enum": ["NONE", "INVENTORY_BOUND", "HOST_TRUST_BOUND", "JOINED_EXISTING_CLUSTER", "ACCESS_HARDENED", "DATA_PLANE_CONVERGED"]},
    "rollback_milestone": {"enum": ["NONE", "ROLLBACK_ADMITTED", "PROVIDER_REVERTED", "ORIGINAL_NODE_RECOVERED", "ZERO_DRIFT_VERIFIED"]},
    "prepare_receipt_sha256": {"$ref": "#/$defs/nullableDigest"},
    "apply_receipt_sha256": {"$ref": "#/$defs/nullableDigest"},
    "state_backup_sha256": {"$ref": "#/$defs/nullableDigest"},
    "recovery_receipt_sha256": {"$ref": "#/$defs/nullableDigest"},
    "postflight_sha256": {"$ref": "#/$defs/nullableDigest"},
    "rollback_receipt_sha256": {"$ref": "#/$defs/nullableDigest"},
    "latest_gate_sha256": {"$ref": "#/$defs/nullableDigest"},
    "failure_class": {"oneOf": [{"type": "null"}, {"enum": ["APPLY_PARTIAL", "APPLY_UNKNOWN", "RECOVERY_UNSAFE", "POSTFLIGHT_UNSAFE", "ROLLBACK_UNSAFE", "POLICY_REFUSAL"]}]},
    "rollback_required": {"type": "boolean"},
    "start_by": {"$ref": "#/$defs/utc"},
    "complete_by": {"$ref": "#/$defs/utc"},
    "resource_expiry_utc": {"$ref": "#/$defs/utc"},
    "minimum_recovery_margin_seconds": {"const": 86400},
    "started_at": {"$ref": "#/$defs/utc"},
    "updated_at": {"$ref": "#/$defs/utc"},
    "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/history"}},
    "raw_values_recorded": {"const": false}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "from_state", "to_state", "event", "receipt_sha256", "cas_nonce", "captured_at"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "from_state": {"oneOf": [{"type": "null"}, {"type": "string"}]},
        "to_state": {"type": "string"},
        "event": {"type": "string"},
        "receipt_sha256": {"$ref": "#/$defs/nullableDigest"},
        "cas_nonce": {"$ref": "#/$defs/digest"},
        "captured_at": {"$ref": "#/$defs/utc"}
      }
    }
  }
}

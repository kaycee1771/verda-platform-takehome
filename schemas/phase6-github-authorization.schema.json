{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verda.example/schemas/phase6-github-authorization.schema.json",
  "title": "Dormant Phase 6 protected-main transaction authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "status", "authorization_mode", "repository", "workflow_id",
    "pr_number", "source_parent_commit", "source_tree_oid", "source_tree_manifest_sha256",
    "operation_id", "operation_nonce", "node", "direction", "plan_sha256",
    "plan_semantic_sha256", "state_lineage_sha256", "state_serial", "contract_sha256",
    "tool_lock_sha256", "broker_sha256", "transaction_policy_sha256", "rollback_policy_sha256",
    "journal_sha256", "journal_generation", "journal_state",
    "user_approval_sha256", "security_review_sha256", "reliability_review_sha256",
    "security_approved", "reliability_approved", "preflight_sha256", "cost_sha256",
    "capacity_sha256", "collector_sha256", "etcd_backup_sha256", "data_backup_sha256",
    "provider_facts_sha256", "approved_resource_expiry_utc", "approved_cost_ceiling_usd",
    "issued_at", "start_by", "raw_values_recorded"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"const": 6},
    "status": {"const": "GITHUB_PROTECTED_MAIN_AUTHORIZED"},
    "authorization_mode": {"const": "TRANSACTION"},
    "repository": {"const": "kaycee1771/verda-platform-takehome"},
    "workflow_id": {"const": 335664221},
    "pr_number": {"type": "integer", "minimum": 1},
    "source_parent_commit": {"$ref": "#/$defs/commit"},
    "source_tree_oid": {"$ref": "#/$defs/commit"},
    "source_tree_manifest_sha256": {"$ref": "#/$defs/digest"},
    "operation_id": {"$ref": "#/$defs/digest"},
    "operation_nonce": {"$ref": "#/$defs/digest"},
    "node": {"enum": ["01", "02", "03"]},
    "direction": {"enum": ["resize", "rollback"]},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "plan_semantic_sha256": {"$ref": "#/$defs/digest"},
    "state_lineage_sha256": {"$ref": "#/$defs/digest"},
    "state_serial": {"type": "integer", "minimum": 0},
    "contract_sha256": {"$ref": "#/$defs/digest"},
    "tool_lock_sha256": {"$ref": "#/$defs/digest"},
    "broker_sha256": {"$ref": "#/$defs/digest"},
    "transaction_policy_sha256": {"$ref": "#/$defs/digest"},
    "rollback_policy_sha256": {"$ref": "#/$defs/digest"},
    "journal_sha256": {"$ref": "#/$defs/digest"},
    "journal_generation": {"type": "integer", "minimum": 1},
    "journal_state": {"const": "AUTHORIZED"},
    "user_approval_sha256": {"$ref": "#/$defs/digest"},
    "security_review_sha256": {"$ref": "#/$defs/digest"},
    "reliability_review_sha256": {"$ref": "#/$defs/digest"},
    "security_approved": {"const": true},
    "reliability_approved": {"const": true},
    "preflight_sha256": {"$ref": "#/$defs/digest"},
    "cost_sha256": {"$ref": "#/$defs/digest"},
    "capacity_sha256": {"$ref": "#/$defs/digest"},
    "collector_sha256": {"$ref": "#/$defs/digest"},
    "etcd_backup_sha256": {"$ref": "#/$defs/digest"},
    "data_backup_sha256": {"$ref": "#/$defs/digest"},
    "provider_facts_sha256": {"$ref": "#/$defs/digest"},
    "approved_resource_expiry_utc": {"const": "2026-08-27T21:00:00Z"},
    "approved_cost_ceiling_usd": {"const": "70.46"},
    "issued_at": {"$ref": "#/$defs/utc"},
    "start_by": {"$ref": "#/$defs/utc"},
    "raw_values_recorded": {"const": false}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
